# Скопируй в .env и заполни. Файл .env в репозиторий не попадает.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456789:replace-me

# Твой Telegram ID (узнать можно у @userinfobot). Бот отвечает только этому пользователю.
ADMIN_TG_ID=123456789

# Любой OpenAI-совместимый API.
# OpenRouter:
LLM_API_KEY=sk-or-replace-me
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
# DeepSeek:
# LLM_API_KEY=sk-replace-me
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
